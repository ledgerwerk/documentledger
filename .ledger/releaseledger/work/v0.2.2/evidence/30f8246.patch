+                f"  - lines: {unit['line_span'][0]}-{unit['line_span'][1]}",
+                f"  - changed: {', '.join(unit.get('changed_hashes', []) or ['file_hash'])}",
+                f"  - reason: {unit['reason'] or 'No recorded reason.'}",
+                "",
+                "  Current relevant source:",
+                "",
+            ]
+        )
