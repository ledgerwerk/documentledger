+) -> list[str]:
+    heading = {
+        "affected": "## Affected documentation sections",
+        "all": "## Linked documentation sections",
+        "doc": "## Selected documentation sections",
+    }[mode]
+    body = ["# Documentation update context", "", heading, ""]
+    if not has_specs:
