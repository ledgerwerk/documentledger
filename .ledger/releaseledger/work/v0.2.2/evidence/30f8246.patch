+    real_mkdir = Path.mkdir
+
+    def fail_parent(path: Path, *args, **kwargs):
+        if path == blocked_parent:
+            raise PermissionError("permission denied")
+        return real_mkdir(path, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "mkdir", fail_parent)
